        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let data = {};",
                  "try { data = pm.response.json(); } catch (e) {}",
                  "const token = data.token || data.accessToken || data.access_token || data.jwt || (data.data && (data.data.token || data.data.accessToken || data.data.access_token || data.data.jwt));",
                  "if (token) {",
                  "  pm.collectionVariables.set('token', token);",
                  "  console.log('JWT token saved to collection variables.');",
                  "} else {",
                  "  console.log('Token not found automatically. Inspect the login response and save its JWT token manually.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"YOUR_EXISTING_EMAIL\",\n  \"password\": \"YOUR_EXISTING_PASSWORD\"\n}",
              "options": {
